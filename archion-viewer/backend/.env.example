# Archion Viewer — Backend Environment Variables
# Copy this file to .env and fill in your values.

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SQLite database file (default). For Postgres: postgresql://user:pass@host/db
DATABASE_URL=sqlite:///./archion_viewer.db

# Directory where uploaded model files are stored
UPLOAD_DIR=./uploads

# Maximum accepted upload size in bytes (default: 100 MB)
MAX_UPLOAD_SIZE=104857600
